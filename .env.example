# Groq API configuration (Required for query execution)
# Sign up at https://console.groq.com to get your API key
GROQ_API_KEY=your_groq_api_key_here

# Groq Model ID (Optional, defaults to llama3-8b-8192)
# Supported options include llama3-8b-8192, llama3-70b-8192, mixtral-8x7b-32768
GROQ_MODEL=llama3-8b-8192

# HuggingFace Embedding Model (Optional, defaults to sentence-transformers/all-MiniLM-L6-v2)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval parameters (number of top chunks retrieved per agent)
RETRIEVAL_TOP_K=5

# Document chunking parameters
# CHUNK_MAX_CHARS: Soft maximum character count for prose chunks
# CHUNK_OVERLAP_CHARS: Overlap context from preceding prose chunk
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP_CHARS=150
